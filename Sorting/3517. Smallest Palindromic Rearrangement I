class Solution:
    def smallestPalindrome(self, s: str) -> str:
        freq = [0] * 26

        for ch in s:
            freq[ord(ch) - ord('a')] += 1

        n = len(s)
        ans = [''] * n

        l, r = 0, n-1

        for i in range(26):
            while freq[i] >= 2:
                ans[l] = chr(ord('a') + i)
                ans[r] = chr(ord('a') + i)
                l += 1
                r -= 1
                freq[i] -= 2
            
            if freq[i] == 1:
                ans[n // 2] = chr(ord('a') + i)

        return ''.join(ans)
